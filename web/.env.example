# Copy to web/.env.local for local runs (git ignores it), and add the same values in Vercel:
# Project -> Settings -> Environment Variables. Without NEXT_PUBLIC_SALDA_ADDRESS the app runs on sample data only.

# ---- Public (sent to the browser) ----

# SaldaClearing on Aevum testnet, printed by `forge script script/Deploy.s.sol`.
NEXT_PUBLIC_SALDA_ADDRESS=

# Enables WalletConnect (phone wallets). Free at https://cloud.reown.com
NEXT_PUBLIC_WC_PROJECT_ID=

# ---- Server only (no NEXT_PUBLIC_ prefix: never sent to the browser) ----
# Use fresh TEST-ONLY wallets for every key below. Never one that holds anything of value.

# Pays gas for every relayed action, and is the demo treasury: needs tQDAY, plus tUSD8 for demo seeds.
RELAYER_PRIVATE_KEY=

# The clearing agent's approval key. Holds no funds and needs no gas.
AGENT_PRIVATE_KEY=
# ERC-8004 agent ID, once QDay confirms the registry. 0 = none.
AGENT_ID=0
# Circles the scheduled agent runs for, comma-separated (e.g. 1,4). Empty = only "Run clearing now".
AGENT_CIRCLES=
# Vercel sends this with its cron calls. Any long random string.
CRON_SECRET=

# The two demo counterparties, Ben and Chidi, played by the server in /demo.
DEMO_BEN_KEY=
DEMO_CHIDI_KEY=
# Printed by `forge script script/DemoSetup.s.sol`. Enables the live "Simulated compromised agent".
DEMO_ATTACK_CIRCLE=
DEMO_ATTACK_INVOICES=
# Most demo seeds (0.02 tUSD8 each) per day, across all visitors.
DEMO_DAILY_LIMIT=100

# Shared store (Upstash Redis REST). Without it, the server keeps state in memory, which is fine for
# `npm run dev` but loses everything on Vercel between requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The header Vercel sets with the real client IP, for rate limits.
TRUSTED_IP_HEADER=x-vercel-forwarded-for
# Most transactions the relayer sends per day.
RELAYER_DAILY_TX_LIMIT=500

# AI clearing agent (Groq). Without GROQ_API_KEY, the rules-based agent runs instead.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Most AI agent runs per day, across everyone.
AI_DAILY_LIMIT=300
